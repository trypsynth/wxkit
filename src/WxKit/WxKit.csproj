<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>WxKit</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- The library builds without warnings, so any new one, such as the trim and AOT analyzers'
		     for a binding that would break Native AOT, fails the build. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WxKit</PackageId>
		<Description>.NET bindings to wxWidgets, for native desktop applications. Links wxWidgets into Native AOT executables.</Description>
		<PackageTags>wxwidgets;gui;desktop;native;native-aot;accessibility</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/trypsynth/wxkit</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>https://github.com/trypsynth/wxkit/releases</PackageReleaseNotes>
		<!-- The symbols go to nuget.org's symbol server, and Source Link points them at the commit. -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<!-- The repository's README is for working on WxKit. The package's is for using it. -->
		<None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
		<None Include="../../LICENSE" Pack="true" PackagePath="/" />
		<None Include="build/WxKit.targets;build/wxkit.manifest;build/WxKitMergeResources.cs;build/WxKitStdCatalogs.cs;build/WxKitCheckCatalogs.cs;build/WxKitExtractStrings.cs" Pack="true" PackagePath="buildTransitive/" />
	</ItemGroup>

	<!-- The package depends on a native package for each runtime, which scripts/pack.ps1 packs first and passes as WxKitRuntimes, joined with plus signs. Building WxKit itself does not need them. -->
	<ItemGroup Condition="'$(WxKitPacking)' == 'true'">
		<_WxKitRuntime Include="$([MSBuild]::Unescape($(WxKitRuntimes.Replace('+', ';'))))" />
		<!-- Nothing is private, so the native package's targets reach the application, which links with them. -->
		<PackageReference Include="@(_WxKitRuntime->'WxKit.Native.%(Identity)')" Version="$(Version)" PrivateAssets="none" />
	</ItemGroup>

	<!-- wxWidgets' catalogs are the same for every runtime, so the package has one copy, from one of their builds. -->
	<Target Name="_WxKitPackStdCatalogs" BeforeTargets="_GetPackageFiles" Condition="'$(WxKitPacking)' == 'true'">
		<PropertyGroup>
			<_WxKitCatalogRuntime>%(_WxKitRuntime.Identity)</_WxKitCatalogRuntime>
		</PropertyGroup>
		<ItemGroup>
			<_WxKitStdCatalog Include="$(WxKitNativeRoot)/$(_WxKitCatalogRuntime)/locale/**/wxstd.mo" />
			<!-- NuGet adds the folder each catalog is in, below locale, by itself. -->
			<None Include="@(_WxKitStdCatalog)" Pack="true" PackagePath="locale/" />
		</ItemGroup>
		<Error Condition="'@(_WxKitStdCatalog)' == ''" Text="The native build for $(_WxKitCatalogRuntime) has no catalogs in $(WxKitNativeRoot)/$(_WxKitCatalogRuntime)/locale. Install GNU gettext, and run scripts/build-native.ps1 again." />
	</Target>

	<ItemGroup>
		<InternalsVisibleTo Include="WxKit.Tests" />
	</ItemGroup>

	<!-- The merge task is compiled by MSBuild in the consuming build, not as part of WxKit. -->
	<ItemGroup>
		<Compile Remove="build/**" />
	</ItemGroup>

</Project>
