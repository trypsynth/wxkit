<Project>

	<!-- Native AOT links wxWidgets and the shim into the executable, so nothing ships beside it. Everything else loads wxkitnative.dll from the native package's runtimes folder. The native package for the runtime, such as WxKit.Native.win-x64, sets WxKitNativeDirectory to its static build; a project that builds WxKit itself sets it to its own. -->
	<PropertyGroup>
		<WxKitStaticLink Condition="'$(WxKitStaticLink)' == '' and '$(PublishAot)' == 'true'">true</WxKitStaticLink>
		<_WxKitLinkTargets>$(WxKitNativeDirectory)WxKit.Native.targets</_WxKitLinkTargets>
	</PropertyGroup>

	<!-- wxMSW needs version 6 of the common controls for themed controls, and per-monitor DPI awareness. An application with a manifest of its own has to declare both itself. -->
	<PropertyGroup Condition="'$(ApplicationManifest)' == '' and '$(NoWin32Manifest)' != 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">
		<ApplicationManifest>$(MSBuildThisFileDirectory)wxkit.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup Condition="'$(WxKitStaticLink)' == 'true'">
		<DirectPInvoke Include="wxkitnative" />
	</ItemGroup>

	<!-- Implicit usings import System.Threading, whose Timer makes WxKit's ambiguous. An alias wins over an imported namespace, so this makes a bare Timer mean WxKit's. Set WxKitTimerAlias to false to leave it out. The project's extension stands in for its language, which the SDK has not set yet when a project imports this file itself. -->
	<ItemGroup Condition="'$(WxKitTimerAlias)' != 'false' and '$(MSBuildProjectExtension)' == '.csproj' and ('$(ImplicitUsings)' == 'true' or '$(ImplicitUsings)' == 'enable')">
		<Using Include="WxKit.Timer" Alias="Timer" />
	</ItemGroup>

	<!--
		wxWidgets' own text, such as stock button labels and the text of its dialogs, is translated
		from its catalogs, which are embedded for each language the application has, so that it
		follows the application's language. The languages are the WxKitLanguage items, which are by
		default the names of the application's catalogs in its po folder, such as de for po/de.po. Set
		WxKitStdCatalogs to all to embed all 46 of wxWidgets' catalogs, about 6 MB, or to none to embed
		none. A project that builds WxKit itself sets WxKitStdCatalogDirectory to its native build's.
	-->
	<PropertyGroup>
		<WxKitPoDirectory Condition="'$(WxKitPoDirectory)' == ''">po</WxKitPoDirectory>
		<WxKitStdCatalogDirectory Condition="'$(WxKitStdCatalogDirectory)' == ''">$(MSBuildThisFileDirectory)../locale/</WxKitStdCatalogDirectory>
	</PropertyGroup>

	<UsingTask TaskName="WxKitStdCatalogs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Directory ParameterType="System.String" Required="true" />
			<Languages ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
			<All ParameterType="System.Boolean" />
			<Catalogs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
		</ParameterGroup>
		<Task>
			<Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)WxKitStdCatalogs.cs" />
		</Task>
	</UsingTask>

	<!-- Resources are sorted by culture in AssignTargetPaths' dependents, so the catalogs are added before it. -->
	<Target Name="_WxKitEmbedStdCatalogs" BeforeTargets="AssignTargetPaths" Condition="'$(WxKitStdCatalogs)' != 'none' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">
		<ItemGroup>
			<_WxKitPoFile Include="$(WxKitPoDirectory)/*.po" />
			<_WxKitLanguage Include="@(WxKitLanguage)" />
			<_WxKitLanguage Include="@(_WxKitPoFile->'%(Filename)')" Condition="'@(WxKitLanguage)' == ''" />
		</ItemGroup>
		<WxKitStdCatalogs Directory="$(WxKitStdCatalogDirectory)" Languages="@(_WxKitLanguage)" All="$([System.String]::Equals('$(WxKitStdCatalogs)', 'all'))">
			<Output TaskParameter="Catalogs" ItemName="EmbeddedResource" />
		</WxKitStdCatalogs>
	</Target>

	<!--
		The application's own catalogs, the .po files in its po folder, such as po/de.po, are compiled
		with GNU gettext's msgfmt on each build that changes them, and embedded as
		locale/<language>/<domain>.mo, where EmbeddedTranslationsLoader finds them. The domain is
		WxKitTranslationDomain, the assembly's name by default, which the application passes to
		Translations.Use. msgfmt checks that each translation formats as its original does, and
		leaves out entries marked fuzzy, as gettext does, until a translator reviews them. Set
		WxKitMsgfmt to msgfmt's path when it is not on the PATH. Without msgfmt, the build warns and
		embeds no catalogs, so the application's text stays in English.
	-->
	<PropertyGroup>
		<WxKitMsgfmt Condition="'$(WxKitMsgfmt)' == ''">msgfmt</WxKitMsgfmt>
	</PropertyGroup>

	<Target Name="_WxKitResolveCatalogs">
		<PropertyGroup>
			<_WxKitTranslationDomain>$(WxKitTranslationDomain)</_WxKitTranslationDomain>
			<_WxKitTranslationDomain Condition="'$(_WxKitTranslationDomain)' == ''">$(AssemblyName)</_WxKitTranslationDomain>
			<_WxKitCompiledCatalogs>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)wxkit-locale'))</_WxKitCompiledCatalogs>
		</PropertyGroup>
		<!-- Metadata in a target cannot name its own item's file name, so the catalogs are made from another item. -->
		<ItemGroup>
			<_WxKitCatalogSource Include="$(WxKitPoDirectory)/*.po" />
			<_WxKitCatalog Include="@(_WxKitCatalogSource)">
				<Compiled>$(_WxKitCompiledCatalogs)/%(_WxKitCatalogSource.Filename)/$(_WxKitTranslationDomain).mo</Compiled>
				<LogicalName>locale/$([System.String]::Copy('%(_WxKitCatalogSource.Filename)').Replace('-', '_'))/$(_WxKitTranslationDomain).mo</LogicalName>
			</_WxKitCatalog>
		</ItemGroup>
		<Exec Command="&quot;$(WxKitMsgfmt)&quot; --version" Condition="'@(_WxKitCatalog)' != ''" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
			<Output TaskParameter="ExitCode" PropertyName="_WxKitMsgfmtExitCode" />
		</Exec>
		<Warning Condition="'@(_WxKitCatalog)' != '' and '$(_WxKitMsgfmtExitCode)' != '0'" Text="msgfmt, from GNU gettext, is not installed, so the catalogs in $(WxKitPoDirectory) are not compiled, and the application's text stays in English. Install gettext: on Windows, winget install mlocati.GetText, on macOS, brew install gettext, and on Linux, the distribution's gettext package. Or set WxKitMsgfmt to msgfmt's path." />
		<ItemGroup Condition="'$(_WxKitMsgfmtExitCode)' != '0'">
			<_WxKitCatalog Remove="@(_WxKitCatalog)" />
		</ItemGroup>
	</Target>

	<Target Name="_WxKitCompileCatalogs" DependsOnTargets="_WxKitResolveCatalogs" Inputs="@(_WxKitCatalog)" Outputs="%(_WxKitCatalog.Compiled)" Condition="'@(_WxKitCatalog)' != ''">
		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(_WxKitCatalog.Compiled)'))" />
		<Exec Command="&quot;$(WxKitMsgfmt)&quot; --check-format --output-file=&quot;%(_WxKitCatalog.Compiled)&quot; &quot;%(_WxKitCatalog.FullPath)&quot;" />
	</Target>

	<!-- A target of its own, so the catalogs are embedded when the compile is skipped as up to date. The compile's condition is checked before its dependencies run, so this resolves the catalogs first. -->
	<Target Name="_WxKitEmbedCatalogs" BeforeTargets="AssignTargetPaths" DependsOnTargets="_WxKitResolveCatalogs;_WxKitCompileCatalogs">
		<ItemGroup>
			<EmbeddedResource Include="@(_WxKitCatalog->'%(Compiled)')" LogicalName="%(_WxKitCatalog.LogicalName)" WithCulture="false" />
			<FileWrites Include="@(_WxKitCatalog->'%(Compiled)')" />
		</ItemGroup>
	</Target>

	<!-- The native package imports the link targets too, when it comes first, since NuGet does not say in which order packages' targets are imported. -->
	<Import Project="$(_WxKitLinkTargets)" Condition="'$(WxKitStaticLink)' == 'true' and '$(WxKitNativeDirectory)' != '' and '$(_WxKitLinkTargetsImported)' != 'true' and Exists('$(_WxKitLinkTargets)')" />

	<!-- The linker takes one set of Win32 resources, so the application's own and wxWidgets's are merged into one file, which replaces the copy Native AOT would make of the application's. -->
	<PropertyGroup Condition="'$(WxKitStaticLink)' == 'true' and $(RuntimeIdentifier.StartsWith('win'))">
		<IlcGenerateWin32Resources>false</IlcGenerateWin32Resources>
		<_WxKitMergeWin32Resources>true</_WxKitMergeWin32Resources>
	</PropertyGroup>

	<UsingTask TaskName="WxKitMergeResources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Assembly ParameterType="System.String" Required="true" />
			<Resources ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
			<Output ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)WxKitMergeResources.cs" />
		</Task>
	</UsingTask>

	<!-- Native AOT turns NativeLibrary items into linker arguments in SetupOSSpecificProps, so the merged file has to be named before that. This is a target of its own, rather than part of the merge, so the file is still linked when the merge is skipped as up to date. The path is resolved here rather than at evaluation, because a project can import this file before the SDK sets IntermediateOutputPath. -->
	<Target Name="_WxKitResolveResources" Condition="'$(_WxKitMergeWin32Resources)' == 'true'">
		<PropertyGroup>
			<_WxKitMergedResources>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)wxkit-application.res'))</_WxKitMergedResources>
		</PropertyGroup>
		<ItemGroup>
			<NativeLibrary Include="$(_WxKitMergedResources)" />
		</ItemGroup>
	</Target>

	<Target Name="_WxKitMergeResources" BeforeTargets="SetupOSSpecificProps" DependsOnTargets="_WxKitResolveResources" Condition="'$(_WxKitMergeWin32Resources)' == 'true'" Inputs="@(IntermediateAssembly);@(WxKitResource)" Outputs="$(_WxKitMergedResources)">
		<WxKitMergeResources Assembly="@(IntermediateAssembly->'%(FullPath)')" Resources="@(WxKitResource)" Output="$(_WxKitMergedResources)" />
	</Target>

	<!-- A project in the WxKit repository, such as a sample, names the native build it uses, which a fresh clone does not have until the build script makes it. A package always has its own. -->
	<Target Name="_WxKitCheckNativeDirectory" BeforeTargets="BeforeBuild;PrepareForPublish" Condition="'$(WxKitNativeDirectory)' != '' and !Exists('$(WxKitNativeDirectory)')">
		<Error Text="WxKit's native libraries for '$(RuntimeIdentifier)' are not built yet: there is no $(WxKitNativeDirectory). From the root of the WxKit repository, run ./scripts/build-native.ps1 -Runtimes $(RuntimeIdentifier), which takes 10 to 20 minutes the first time, and build again. An application of your own can use the WxKit package from nuget.org instead, which has them." />
	</Target>

	<Target Name="_WxKitCheckStaticLink" BeforeTargets="PrepareForPublish" Condition="'$(WxKitStaticLink)' == 'true' and '$(_WxKitLinkTargetsImported)' != 'true'">
		<Error Text="WxKit has no static build for '$(RuntimeIdentifier)'. Set WxKitStaticLink to false to ship wxkitnative beside the executable instead." />
	</Target>

	<Target Name="_WxKitDropSharedLibrary" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(WxKitStaticLink)' == 'true'">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'wxkitnative.dll' or '%(Filename)%(Extension)' == 'libwxkitnative.dylib' or '%(Filename)%(Extension)' == 'libwxkitnative.so'" />
		</ItemGroup>
	</Target>

	<!--
		A GUI application on macOS runs from an app bundle, without which its menu bar and focus can
		misbehave. Publishing an application for macOS makes one beside the published files, named
		after it, such as Hello.app. Its Info.plist takes the properties .NET MAUI uses for the same:
		ApplicationTitle, ApplicationId, ApplicationDisplayVersion, and ApplicationVersion. Set
		WxKitMacIcon to an .icns file to give it an icon, WxKitInfoPlist to an Info.plist to use instead
		of WxKit's, and WxKitAppBundle to false to make none.
	-->
	<PropertyGroup Condition="'$(WxKitAppBundle)' == '' and $(RuntimeIdentifier.StartsWith('osx')) and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">
		<WxKitAppBundle>true</WxKitAppBundle>
	</PropertyGroup>

	<!-- Documentation files are for IntelliSense, not for an application, and every file in a bundle's Contents/MacOS has to be signed. -->
	<PropertyGroup Condition="'$(WxKitAppBundle)' == 'true'">
		<PublishDocumentationFile Condition="'$(PublishDocumentationFile)' == ''">false</PublishDocumentationFile>
		<PublishReferencesDocumentationFiles Condition="'$(PublishReferencesDocumentationFiles)' == ''">false</PublishReferencesDocumentationFiles>
	</PropertyGroup>

	<Target Name="_WxKitResolveAppBundle" Condition="'$(WxKitAppBundle)' == 'true'">
		<PropertyGroup>
			<ApplicationTitle Condition="'$(ApplicationTitle)' == ''">$(Product)</ApplicationTitle>
			<ApplicationTitle Condition="'$(ApplicationTitle)' == ''">$(AssemblyName)</ApplicationTitle>
			<!-- A bundle's versions are numbers separated by periods, so a version's prerelease label is left out. -->
			<ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^[0-9]+(\.[0-9]+)*').Value)</ApplicationDisplayVersion>
			<ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0</ApplicationDisplayVersion>
			<ApplicationVersion Condition="'$(ApplicationVersion)' == ''">$(ApplicationDisplayVersion)</ApplicationVersion>
			<_WxKitBundle>$([System.IO.Path]::GetFullPath('$(PublishDir)$(ApplicationTitle).app'))</_WxKitBundle>
			<_WxKitBundleExecutable>$(AssemblyName)</_WxKitBundleExecutable>
			<_WxKitBundleIcon Condition="'$(WxKitMacIcon)' != ''">$([System.IO.Path]::GetFileName('$(WxKitMacIcon)'))</_WxKitBundleIcon>
			<_WxKitBundleIdentifier>$(ApplicationId)</_WxKitBundleIdentifier>
			<_WxKitBundleIdentifier Condition="'$(_WxKitBundleIdentifier)' == ''">$(AssemblyName)</_WxKitBundleIdentifier>
		</PropertyGroup>
	</Target>

	<Target Name="_WxKitCreateAppBundle" AfterTargets="Publish" DependsOnTargets="_WxKitResolveAppBundle" Condition="'$(WxKitAppBundle)' == 'true'">
		<Warning Condition="'$(ApplicationId)' == '' and '$(WxKitInfoPlist)' == ''" Text="Set ApplicationId to the application's bundle identifier, such as com.example.$(AssemblyName). Without one, macOS knows the bundle as $(AssemblyName), which another application can share." />
		<Error Condition="'$(WxKitMacIcon)' != '' and !Exists('$(WxKitMacIcon)')" Text="WxKitMacIcon names $(WxKitMacIcon), which does not exist." />
		<Error Condition="'$(WxKitInfoPlist)' != '' and !Exists('$(WxKitInfoPlist)')" Text="WxKitInfoPlist names $(WxKitInfoPlist), which does not exist." />
		<ItemGroup>
			<!-- Everything published goes in Contents/MacOS, where the executable finds what it loads, but not symbols, or an earlier bundle. -->
			<_WxKitBundleFile Include="$(PublishDir)**/*" Exclude="$(PublishDir)*.app/**;$(PublishDir)**/*.pdb;$(PublishDir)**/*.dSYM/**;$(PublishDir)**/*.dbg" />
			<!-- A question mark in an item is a wildcard, so the declaration's are escaped. -->
			<_WxKitPlistLine Include="&lt;%3Fxml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;%3F&gt;" />
			<_WxKitPlistLine Include="&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;" />
			<_WxKitPlistLine Include="&lt;plist version=&quot;1.0&quot;&gt;" />
			<_WxKitPlistLine Include="&lt;dict&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleName&lt;/key&gt;%0A%09&lt;string&gt;$([System.String]::Copy('$(ApplicationTitle)').Replace('&amp;', '&amp;amp;').Replace('&lt;', '&amp;lt;'))&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleDisplayName&lt;/key&gt;%0A%09&lt;string&gt;$([System.String]::Copy('$(ApplicationTitle)').Replace('&amp;', '&amp;amp;').Replace('&lt;', '&amp;lt;'))&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleIdentifier&lt;/key&gt;%0A%09&lt;string&gt;$(_WxKitBundleIdentifier)&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleExecutable&lt;/key&gt;%0A%09&lt;string&gt;$(_WxKitBundleExecutable)&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleShortVersionString&lt;/key&gt;%0A%09&lt;string&gt;$(ApplicationDisplayVersion)&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleVersion&lt;/key&gt;%0A%09&lt;string&gt;$(ApplicationVersion)&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundlePackageType&lt;/key&gt;%0A%09&lt;string&gt;APPL&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleInfoDictionaryVersion&lt;/key&gt;%0A%09&lt;string&gt;6.0&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleDevelopmentRegion&lt;/key&gt;%0A%09&lt;string&gt;en&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;CFBundleIconFile&lt;/key&gt;%0A%09&lt;string&gt;$(_WxKitBundleIcon)&lt;/string&gt;" Condition="'$(_WxKitBundleIcon)' != ''" />
			<_WxKitPlistLine Include="%09&lt;key&gt;NSHumanReadableCopyright&lt;/key&gt;%0A%09&lt;string&gt;$([System.String]::Copy('$(Copyright)').Replace('&amp;', '&amp;amp;').Replace('&lt;', '&amp;lt;'))&lt;/string&gt;" Condition="'$(Copyright)' != ''" />
			<_WxKitPlistLine Include="%09&lt;key&gt;LSMinimumSystemVersion&lt;/key&gt;%0A%09&lt;string&gt;12.0&lt;/string&gt;" />
			<!-- wxWidgets's own bundles name its application class, which handles the events Cocoa sends it. -->
			<_WxKitPlistLine Include="%09&lt;key&gt;NSPrincipalClass&lt;/key&gt;%0A%09&lt;string&gt;wxNSApplication&lt;/string&gt;" />
			<_WxKitPlistLine Include="%09&lt;key&gt;NSHighResolutionCapable&lt;/key&gt;%0A%09&lt;true/&gt;" />
			<_WxKitPlistLine Include="&lt;/dict&gt;" />
			<_WxKitPlistLine Include="&lt;/plist&gt;" />
		</ItemGroup>
		<RemoveDir Directories="$(_WxKitBundle)" />
		<Copy SourceFiles="@(_WxKitBundleFile)" DestinationFiles="@(_WxKitBundleFile->'$(_WxKitBundle)/Contents/MacOS/%(RecursiveDir)%(Filename)%(Extension)')" />
		<Copy SourceFiles="$(WxKitMacIcon)" DestinationFolder="$(_WxKitBundle)/Contents/Resources" Condition="'$(WxKitMacIcon)' != ''" />
		<WriteLinesToFile File="$(_WxKitBundle)/Contents/Info.plist" Lines="@(_WxKitPlistLine)" Overwrite="true" Condition="'$(WxKitInfoPlist)' == ''" />
		<Copy SourceFiles="$(WxKitInfoPlist)" DestinationFiles="$(_WxKitBundle)/Contents/Info.plist" Condition="'$(WxKitInfoPlist)' != ''" />
		<WriteLinesToFile File="$(_WxKitBundle)/Contents/PkgInfo" Lines="APPL????" Overwrite="true" />
		<Message Importance="high" Text="$(MSBuildProjectName) -> $(_WxKitBundle)" />
	</Target>

	<!--
		Signs the bundle on a Mac, innermost first, as Apple recommends over deep signing: each file in
		Contents/MacOS other than the executable, such as a library, then the executable, then the
		bundle. A file that is not code, such as a framework-dependent application's assemblies, gets
		its signature in its extended attributes. With WxKitCodesignIdentity, such as
		"Developer ID Application: Jane Doe (TEAMID)", it signs with the hardened runtime and a secure
		timestamp, which notarization needs. An application that is not Native AOT gets the entitlement
		to compile code at run time, which .NET's JIT needs under the hardened runtime, and one that is
		framework dependent the entitlement to load libraries another team signed, since it loads .NET
		from its shared install, which Microsoft signed.
		Without one, it signs ad hoc, which runs on the Mac that built it.
	-->
	<Target Name="_WxKitSignAppBundle" AfterTargets="_WxKitCreateAppBundle" Condition="'$(WxKitAppBundle)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">
		<PropertyGroup>
			<_WxKitSigningIdentity>$(WxKitCodesignIdentity)</_WxKitSigningIdentity>
			<_WxKitSigningIdentity Condition="'$(_WxKitSigningIdentity)' == ''">-</_WxKitSigningIdentity>
			<_WxKitSigningOptions Condition="'$(WxKitCodesignIdentity)' != ''">--timestamp --options runtime</_WxKitSigningOptions>
			<_WxKitEntitlements Condition="'$(WxKitCodesignIdentity)' != '' and '$(PublishAot)' != 'true'">$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)wxkit.entitlements'))</_WxKitEntitlements>
			<_WxKitEntitlementsOption Condition="'$(_WxKitEntitlements)' != ''">--entitlements &quot;$(_WxKitEntitlements)&quot;</_WxKitEntitlementsOption>
		</PropertyGroup>
		<ItemGroup>
			<_WxKitSignedFile Include="$(_WxKitBundle)/Contents/MacOS/**/*" Exclude="$(_WxKitBundle)/Contents/MacOS/$(_WxKitBundleExecutable)" />
			<_WxKitEntitlementLine Include="&lt;%3Fxml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;%3F&gt;;&lt;!DOCTYPE plist PUBLIC &quot;-//Apple//DTD PLIST 1.0//EN&quot; &quot;http://www.apple.com/DTDs/PropertyList-1.0.dtd&quot;&gt;;&lt;plist version=&quot;1.0&quot;&gt;;&lt;dict&gt;;%09&lt;key&gt;com.apple.security.cs.allow-jit&lt;/key&gt;;%09&lt;true/&gt;" />
			<_WxKitEntitlementLine Include="%09&lt;key&gt;com.apple.security.cs.disable-library-validation&lt;/key&gt;;%09&lt;true/&gt;" Condition="'$(SelfContained)' != 'true'" />
			<_WxKitEntitlementLine Include="&lt;/dict&gt;;&lt;/plist&gt;" />
		</ItemGroup>
		<WriteLinesToFile File="$(_WxKitEntitlements)" Lines="@(_WxKitEntitlementLine)" Overwrite="true" Condition="'$(_WxKitEntitlements)' != ''" />
		<Exec Command="codesign --force $(_WxKitSigningOptions) --sign &quot;$(_WxKitSigningIdentity)&quot; &quot;%(_WxKitSignedFile.FullPath)&quot;" Condition="'@(_WxKitSignedFile)' != ''" />
		<Exec Command="codesign --force $(_WxKitSigningOptions) $(_WxKitEntitlementsOption) --sign &quot;$(_WxKitSigningIdentity)&quot; &quot;$(_WxKitBundle)/Contents/MacOS/$(_WxKitBundleExecutable)&quot;" />
		<Exec Command="codesign --force $(_WxKitSigningOptions) $(_WxKitEntitlementsOption) --sign &quot;$(_WxKitSigningIdentity)&quot; &quot;$(_WxKitBundle)&quot;" />
	</Target>

</Project>
