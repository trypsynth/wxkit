<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<!-- The machine's own system and architecture, unless the publish names another. -->
		<_HelloSystem Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_HelloSystem>
		<_HelloSystem Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_HelloSystem>
		<_HelloSystem Condition="'$(_HelloSystem)' == ''">win</_HelloSystem>
		<_HelloArchitecture Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_HelloArchitecture>
		<_HelloArchitecture Condition="'$(_HelloArchitecture)' == ''">x64</_HelloArchitecture>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(_HelloSystem)-$(_HelloArchitecture)</RuntimeIdentifier>
		<PublishAot>true</PublishAot>
		<!-- On macOS, the app bundle is named after the title and known by the identifier. -->
		<ApplicationTitle>Hello</ApplicationTitle>
		<ApplicationId>io.github.trypsynth.wxkit.hello</ApplicationId>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- WxKit comes from its source or from its package, as samples/Directory.Build.targets says. -->

</Project>
