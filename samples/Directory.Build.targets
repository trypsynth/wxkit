<Project>

	<!--
		The samples build with WxKit's own source and the native libraries scripts/build-native.ps1
		builds, when there are ones for the runtime. A fresh clone has none, so the samples use the
		newest WxKit package from nuget.org instead, which has them, as the floating version *-*
		finds it, so the samples follow each release without a change here. A sample that uses
		something newer than that release needs the native build. Set WxKitSamplesFromSource to
		false to use the package anyway, or WxKitPackageVersion to use a particular release.
	-->
	<PropertyGroup>
		<WxKitSamplesFromSource Condition="'$(WxKitSamplesFromSource)' == '' and Exists('$(WxKitNativeRoot)/$(RuntimeIdentifier)')">true</WxKitSamplesFromSource>
		<WxKitPackageVersion Condition="'$(WxKitPackageVersion)' == ''">*-*</WxKitPackageVersion>
		<WxKitNativeDirectory Condition="'$(WxKitSamplesFromSource)' == 'true'">$(WxKitNativeRoot)/$(RuntimeIdentifier)/static/</WxKitNativeDirectory>
		<WxKitStdCatalogDirectory Condition="'$(WxKitSamplesFromSource)' == 'true'">$(WxKitNativeRoot)/$(RuntimeIdentifier)/locale/</WxKitStdCatalogDirectory>
	</PropertyGroup>

	<ItemGroup Condition="'$(WxKitSamplesFromSource)' == 'true'">
		<ProjectReference Include="$(MSBuildThisFileDirectory)../src/WxKit/WxKit.csproj" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)../src/WxKit.FSharp/WxKit.FSharp.fsproj" Condition="'$(MSBuildProjectExtension)' == '.fsproj'" />
		<None Include="$(WxKitNativeRoot)/$(RuntimeIdentifier)/shared/*.dll;$(WxKitNativeRoot)/$(RuntimeIdentifier)/shared/*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<!-- On Linux, a sample with a web view takes the shared library built with one. -->
		<None Include="$(WxKitNativeRoot)/$(RuntimeIdentifier)/shared/*.so" Condition="'$(WxKitWebView)' != 'true'" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<None Include="$(WxKitNativeRoot)/$(RuntimeIdentifier)/shared/webview/*.so" Condition="'$(WxKitWebView)' == 'true'" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- An F# sample uses WxKit.FSharp, which brings WxKit with it. -->
	<ItemGroup Condition="'$(WxKitSamplesFromSource)' != 'true'">
		<PackageReference Include="WxKit" Version="$(WxKitPackageVersion)" Condition="'$(MSBuildProjectExtension)' != '.fsproj'" />
		<PackageReference Include="WxKit.FSharp" Version="$(WxKitPackageVersion)" Condition="'$(MSBuildProjectExtension)' == '.fsproj'" />
	</ItemGroup>

	<!-- A package reference brings these in on its own. A project reference has to ask. -->
	<Import Project="$(MSBuildThisFileDirectory)../src/WxKit/build/WxKit.targets" Condition="'$(WxKitSamplesFromSource)' == 'true'" />

</Project>
