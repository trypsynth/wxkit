<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- On macOS, the app bundle is named after the title and known by the identifier. -->
		<ApplicationTitle>Checksums</ApplicationTitle>
		<ApplicationId>io.github.trypsynth.wxkit.checksums.fsharp</ApplicationId>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Checksum.fs" />
		<Compile Include="ChecksumsFrame.fs" />
		<Compile Include="Program.fs" />
	</ItemGroup>

	<!-- WxKit comes from its source or from its package, as samples/Directory.Build.targets says, and what a sample is from samples/Directory.Build.props. -->

</Project>
