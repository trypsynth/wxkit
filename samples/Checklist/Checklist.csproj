<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<!-- The machine's own system and architecture, unless the publish names another. -->
		<_ChecklistSystem Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_ChecklistSystem>
		<_ChecklistSystem Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_ChecklistSystem>
		<_ChecklistSystem Condition="'$(_ChecklistSystem)' == ''">win</_ChecklistSystem>
		<_ChecklistArchitecture Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_ChecklistArchitecture>
		<_ChecklistArchitecture Condition="'$(_ChecklistArchitecture)' == ''">x64</_ChecklistArchitecture>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(_ChecklistSystem)-$(_ChecklistArchitecture)</RuntimeIdentifier>
		<PublishAot>true</PublishAot>
		<IsPackable>false</IsPackable>
		<!-- On macOS, the app bundle is named after the title and known by the identifier. -->
		<ApplicationTitle>Checklist</ApplicationTitle>
		<ApplicationId>io.github.trypsynth.wxkit.checklist</ApplicationId>
	</PropertyGroup>

	<!-- WxKit comes from its source or from its package, as samples/Directory.Build.targets says. -->

</Project>
