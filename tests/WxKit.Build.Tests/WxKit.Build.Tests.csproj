<Project Sdk="Microsoft.NET.Sdk">

	<!-- The build tasks MSBuild compiles from WxKit's build folder, compiled here to test what they read and write. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- System.Threading.Tasks' Task would clash with MSBuild's, which the tasks derive from, as MSBuild compiles them without implicit usings. -->
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.3" />
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\src\WxKit\build\WxKitExtractStrings.cs;..\..\src\WxKit\build\WxKitCheckCatalogs.cs;..\..\src\WxKit\build\WxKitStdCatalogs.cs" Link="Tasks\%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- TargetsTests runs WxKit's targets themselves, from the repository. -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>TargetsFile</_Parameter1>
			<_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/WxKit/build/WxKit.targets'))</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<Using Include="System" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.Linq" />
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
