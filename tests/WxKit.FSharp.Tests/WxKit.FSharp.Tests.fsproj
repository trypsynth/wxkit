<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- wxWidgets has to own the main thread, so Program.fs is the entry point instead of xUnit's, as in WxKit.Tests. -->
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
		<!-- F# needs the entry point in the last file, after the one the testing platform would generate, so Program.fs adds its extensions itself. -->
		<GenerateSelfRegisteredExtensions>false</GenerateSelfRegisteredExtensions>
		<_WxKitTestSystem Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_WxKitTestSystem>
		<_WxKitTestSystem Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_WxKitTestSystem>
		<_WxKitTestSystem Condition="'$(_WxKitTestSystem)' == ''">win</_WxKitTestSystem>
		<_WxKitTestArchitecture Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_WxKitTestArchitecture>
		<_WxKitTestArchitecture Condition="'$(_WxKitTestArchitecture)' == ''">x64</_WxKitTestArchitecture>
		<WxKitTestRuntime Condition="'$(WxKitTestRuntime)' == ''">$(_WxKitTestSystem)-$(_WxKitTestArchitecture)</WxKitTestRuntime>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Gui.fs" />
		<Compile Include="TranslationTests.fs" />
		<Compile Include="LayoutTests.fs" />
		<Compile Include="Program.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\WxKit.FSharp\WxKit.FSharp.fsproj" />
	</ItemGroup>

	<Import Project="..\..\src\WxKit\build\WxKit.targets" />

	<ItemGroup>
		<None Include="$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/*.dll;$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/*.dylib;$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/*.so" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\WxKit.Tests\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- xUnit adds F# files of its own after the project's, and the entry point has to come last. -->
	<Target Name="_WxKitEntryPointLast" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Compile Remove="Program.fs" />
			<Compile Include="Program.fs" />
		</ItemGroup>
	</Target>

	<Target Name="_WxKitCheckTestNativeLibrary" BeforeTargets="BeforeBuild" Condition="!Exists('$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared')">
		<Error Text="The tests need WxKit's native libraries for '$(WxKitTestRuntime)', which are not built yet. From the root of the WxKit repository, run ./scripts/build-native.ps1 -Runtimes $(WxKitTestRuntime), and run the tests again." />
	</Target>

</Project>
