<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- wxWidgets has to own the main thread, so Program.cs is the entry point instead of xUnit's. -->
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
		<!-- The tests run as the machine's own system and architecture, so they load the native build for it. -->
		<_WxKitTestSystem Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_WxKitTestSystem>
		<_WxKitTestSystem Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_WxKitTestSystem>
		<_WxKitTestSystem Condition="'$(_WxKitTestSystem)' == ''">win</_WxKitTestSystem>
		<_WxKitTestArchitecture Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</_WxKitTestArchitecture>
		<_WxKitTestArchitecture Condition="'$(_WxKitTestArchitecture)' == ''">x64</_WxKitTestArchitecture>
		<WxKitTestRuntime Condition="'$(WxKitTestRuntime)' == ''">$(_WxKitTestSystem)-$(_WxKitTestArchitecture)</WxKitTestRuntime>
		<!-- The tests create web views. -->
		<WxKitWebView>true</WxKitWebView>
		<WxKitStdCatalogDirectory>$(WxKitNativeRoot)/$(WxKitTestRuntime)/locale/</WxKitStdCatalogDirectory>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\WxKit\WxKit.csproj" />
	</ItemGroup>

	<!-- The tests run as an application would, with WxKit's manifest and Timer alias. -->
	<Import Project="..\..\src\WxKit\build\WxKit.targets" />

	<ItemGroup>
		<!-- The tests create web views, so on Linux they take the shared library built with one. -->
		<None Include="$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/*.dll;$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/*.dylib;$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared/webview/*.so" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
		<!-- The public API snapshot, which PublicApiTests compares with, and rewrites from the project's own folder. -->
		<Content Include="PublicApi.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('PublicApi.txt')" />
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>ProjectDirectory</_Parameter1>
			<_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<!-- The tests run against the native build, which a fresh clone does not have until the build script makes it. -->
	<Target Name="_WxKitCheckTestNativeLibrary" BeforeTargets="BeforeBuild" Condition="!Exists('$(WxKitNativeRoot)/$(WxKitTestRuntime)/shared')">
		<Error Text="The tests need WxKit's native libraries for '$(WxKitTestRuntime)', which are not built yet: there is no $(WxKitNativeRoot)/$(WxKitTestRuntime)/shared. From the root of the WxKit repository, run ./scripts/build-native.ps1 -Runtimes $(WxKitTestRuntime), which takes 10 to 20 minutes the first time, and run the tests again." />
	</Target>

</Project>
