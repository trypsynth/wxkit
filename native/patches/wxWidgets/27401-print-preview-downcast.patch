From 82cfe341daa062216f481c0187518f9ff5f2ed9e Mon Sep 17 00:00:00 2001
From: Quin Gillespie
Date: Sun, 22 Nov 2026 23:23:22 -0700
Subject: [PATCH] Set the printout's preview from wxPrintPreview itself

wxPrintPreviewBase::Init(), called from wxPrintPreviewBase constructor,
cast this to wxPrintPreview, which is undefined behaviour, as the object
isn't a wxPrintPreview yet, and UBSan reports it as a downcast of an
address which does not point to an object of type 'wxPrintPreview'.

The implementation object wxPrintPreview creates derives from
wxPrintPreviewBase too, and is never a wxPrintPreview at all, but its
Init() set the printout's preview to it all the same, so the printout's
GetPreview() returned an object of the wrong type.

Set the printout's preview in wxPrintPreview constructors instead, once
the object is fully constructed, so that it's always wxPrintPreview
itself.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/prntbase.cpp | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/common/prntbase.cpp b/src/common/prntbase.cpp
index 7e7eae5bc2..46b77bebb4 100644
--- a/src/common/prntbase.cpp
+++ b/src/common/prntbase.cpp
@@ -1867,8 +1867,6 @@ void wxPrintPreviewBase::Init(wxPrintout *printout,
 {
     m_isOk = true;
     m_previewPrintout = printout;
-    if (m_previewPrintout)
-        m_previewPrintout->SetPreview(static_cast<wxPrintPreview *>(this));
 
     m_printPrintout = printoutForPrinting;
 
@@ -2215,6 +2213,12 @@ wxPrintPreview::wxPrintPreview(wxPrintout *printout,
 {
     m_pimpl = wxPrintFactory::GetFactory()->
         CreatePrintPreview( printout, printoutForPrinting, data );
+
+    // The printout's preview is this object, which only exists as a
+    // wxPrintPreview once its base class constructor has returned, and not
+    // the implementation object, which isn't a wxPrintPreview at all.
+    if ( printout )
+        printout->SetPreview(this);
 }
 
 wxPrintPreview::wxPrintPreview(wxPrintout *printout,
@@ -2224,6 +2228,12 @@ wxPrintPreview::wxPrintPreview(wxPrintout *printout,
 {
     m_pimpl = wxPrintFactory::GetFactory()->
         CreatePrintPreview( printout, printoutForPrinting, data );
+
+    // The printout's preview is this object, which only exists as a
+    // wxPrintPreview once its base class constructor has returned, and not
+    // the implementation object, which isn't a wxPrintPreview at all.
+    if ( printout )
+        printout->SetPreview(this);
 }
 
 wxPrintPreview::~wxPrintPreview()
